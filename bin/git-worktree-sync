#!/usr/bin/env bash

set -euo pipefail
# set -x

PROGRAM="$(basename "$0")"

# Resolve symlinks so bundled files are found when installed via a link on PATH
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# Hooks are grouped by the repo they belong to: hooks/NAME/* installs into DIR/.NAME/hooks.
# The same relative path works from a repo checkout and an installed prefix (e.g. Homebrew's pkgshare)
HOOKS_SRC="$(dirname "$SCRIPT_DIR")/share/git-worktree-sync/hooks"
HOOK_REPOS=(remote.bare worktreesync.bare)

# Branch used by the worktreesync hub; the post-checkout hook tracks origin/master
SYNC_BRANCH="master"


usage() {
	cat <<EOF
Usage: $PROGRAM [OPTIONS] COMMAND [ARGS...]

Manage a worktree based project layout and sync local files across worktrees.

Commands:
  clone ORIGIN [DIR]
                    Clone ORIGIN as a bare repo into the new project directory DIR
                    and set up the worktreesync hub for local files; DIR defaults
                    to the repo name from ORIGIN, as with git clone
  add [-u] [PATH...]
                    Stage PATHs in the current worktree's .worktreesync, recording
                    them in .worktreeinclude and the project's info/exclude
  commit [-m MESSAGE]
                    Commit staged changes in the current worktree's .worktreesync
  push              Push the current worktree's .worktreesync commits to the hub
  pull [-r]         Pull hub commits into the current worktree's .worktreesync
  status            Show the current worktree's .worktreesync status against the hub

Options:
  -h, --help        Show this help message and exit
  -u, --update      With add: stage changes to tracked files and new files in
                    directories listed in .worktreeinclude
  -m, --message     With commit: use MESSAGE instead of opening an editor
  -r, --rebase      With pull: rebase local commits onto the hub instead of
                    following the pull settings in your git config
EOF
}


die() {
	echo "$PROGRAM: $*" >&2
	exit 1
}


main() {
	# Require util-linux (enhanced) getopt, which exits 4 when probed with -T
	getopt -T >/dev/null && die "GNU enhanced getopt is required"

	local parsed
	parsed="$(getopt --name "$PROGRAM" --options 'hum:r' --longoptions 'help,update,message:,rebase' -- "$@")" \
		|| { usage >&2; exit 2; }
	eval set -- "$parsed"

	local update=false
	local message=""
	local has_message=false
	local rebase=false

	while true; do
		case "$1" in
			-h | --help)
				usage
				exit 0
				;;
			-u | --update)
				update=true
				;;
			-m | --message)
				shift
				message="$1"
				has_message=true
				;;
			-r | --rebase)
				rebase=true
				;;
			--)
				shift
				break
				;;
			*)
				die "unhandled option: $1"
				;;
		esac
		shift
	done

	if [[ $# -eq 0 ]]; then
		die "expected a command; try --help"
	fi

	local command="$1"
	shift
	case "$command" in
		clone)
			if [[ $# -lt 1 ]] || [[ $# -gt 2 ]]; then
				die "clone: expected ORIGIN [DIR]"
			fi
			if [ "$update" = true ] || [ "$has_message" = true ] || [ "$rebase" = true ]; then
				die "clone: unexpected option"
			fi
			# Assign separately so a failed guess stops the script under set -e
			local dir="${2:-}"
			if [ -z "$dir" ]; then
				dir="$(origin_dir_name "$1")"
			fi
			project_clone "$1" "$dir"
			;;
		add)
			if [ "$has_message" = true ] || [ "$rebase" = true ]; then
				die "add: unexpected option"
			fi
			if [[ $# -eq 0 ]] && [ "$update" = false ]; then
				die "add: expected PATH... or --update"
			fi
			sync_add "$update" "$@"
			;;
		commit)
			if [ "$update" = true ] || [ "$rebase" = true ]; then
				die "commit: unexpected option"
			fi
			if [[ $# -ne 0 ]]; then
				die "commit: unexpected argument: $1"
			fi
			if [ "$has_message" = true ]; then
				sync_commit "$message"
			else
				sync_commit
			fi
			;;
		push)
			if [ "$update" = true ] || [ "$has_message" = true ] || [ "$rebase" = true ]; then
				die "push: unexpected option"
			fi
			if [[ $# -ne 0 ]]; then
				die "push: unexpected argument: $1"
			fi
			sync_push
			;;
		pull)
			if [ "$update" = true ] || [ "$has_message" = true ]; then
				die "pull: unexpected option"
			fi
			if [[ $# -ne 0 ]]; then
				die "pull: unexpected argument: $1"
			fi
			sync_pull "$rebase"
			;;
		status)
			if [ "$update" = true ] || [ "$has_message" = true ] || [ "$rebase" = true ]; then
				die "status: unexpected option"
			fi
			if [[ $# -ne 0 ]]; then
				die "status: unexpected argument: $1"
			fi
			sync_status
			;;
		*)
			die "unknown command: $command"
			;;
	esac
}


# origin_dir_name origin
# Print the directory name git clone would pick: foo for host:me/foo.git, /src/foo/.git, ...
origin_dir_name() {
	if [[ $# -ne 1 ]]; then
		die "origin_dir_name: expected <origin>"
	fi

	local name="$1"
	while [[ "$name" == */ ]]; do
		name="${name%/}"
	done
	name="${name%/.git}"
	name="${name%.git}"
	name="${name##*/}"
	name="${name##*:}"

	[ -n "$name" ] || die "clone: cannot guess a directory name from $1; pass DIR"
	echo "$name"
}


# project_clone origin dir
project_clone() {
	if [[ $# -ne 2 ]]; then
		die "project_clone: expected <origin> <dir>"
	fi

	local origin="$1"
	local project_dir="$2"

	local repo
	for repo in "${HOOK_REPOS[@]}"; do
		[ -d "$HOOKS_SRC/$repo" ] || die "hooks for .$repo not found at $HOOKS_SRC/$repo"
	done

	# Allow an existing empty directory, but never clobber anything
	if [ -e "$project_dir" ] && [ -n "$(ls -A "$project_dir" 2>/dev/null)" ]; then
		die "$project_dir already exists and is not empty"
	fi

	mkdir -p "$project_dir"
	project_dir="$(realpath "$project_dir")"

	echo "Clone bare repo from $origin"
	git clone --bare "$origin" "$project_dir"/.remote.bare

	# Create a pointer to the bare git to allow commands from the project dir
	echo "gitdir: ./.remote.bare" >"$project_dir"/.git

	# A bare clone maps remote heads straight onto local heads; track them as remotes instead
	echo "Fix bare repo fetch refs"
	git -C "$project_dir" config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
	git -C "$project_dir" fetch origin

	echo "Create worktreesync hub"
	git init --quiet --bare --initial-branch="$SYNC_BRANCH" "$project_dir"/.worktreesync.bare

	# Check out the hub in the project root and seed it with the include list
	git clone --quiet "$project_dir"/.worktreesync.bare "$project_dir"/.worktreesync 2>/dev/null
	echo ".worktreeinclude" >"$project_dir"/.worktreesync/.worktreeinclude
	git -C "$project_dir"/.worktreesync checkout --quiet -B "$SYNC_BRANCH"
	git -C "$project_dir"/.worktreesync add .worktreeinclude
	git -C "$project_dir"/.worktreesync commit --quiet -m "Initial commit"
	git -C "$project_dir"/.worktreesync push --quiet -u origin "$SYNC_BRANCH"

	# Keep the worktreesync files out of the project repo in every worktree
	echo "Add worktreesync files to local excludes"
	mkdir -p "$project_dir"/.remote.bare/info
	cat >>"$project_dir"/.remote.bare/info/exclude <<'EOF'
.worktreesync
.worktreeinclude
EOF

	# .remote.bare: post-checkout sets up .worktreesync on `git worktree add`
	# .worktreesync.bare: post-receive fast-forwards the other worktrees on push
	local hook
	for repo in "${HOOK_REPOS[@]}"; do
		for hook in "$HOOKS_SRC/$repo"/*; do
			[ -f "$hook" ] || continue
			echo "Install .$repo $(basename "$hook") hook"
			install -m 755 "$hook" "$project_dir/.$repo/hooks/$(basename "$hook")"
		done
	done

	echo "Initialized $project_dir"
}


# Set by sync_context: the current worktree and its .worktreesync git dir
worktree=""
sync_dir=""

sync_context() {
	worktree="$(git rev-parse --show-toplevel 2>/dev/null)" \
		|| die "not inside a project worktree"
	sync_dir="$worktree/.worktreesync"
	[ -f "$sync_dir/HEAD" ] || die "no .worktreesync git dir in $worktree"
}


# Run git against the worktree's .worktreesync, with paths relative to the worktree root
sync_git() {
	git -C "$worktree" --literal-pathspecs --git-dir="$sync_dir" --work-tree="$worktree" "$@"
}


# worktree_relpath path
# Print path relative to the worktree root, refusing anything that can't be synced
worktree_relpath() {
	if [[ $# -ne 1 ]]; then
		die "worktree_relpath: expected <path>"
	fi

	local path="$1"
	[ -e "$path" ] || [ -L "$path" ] || die "add: no such file or directory: $path"

	# Let git resolve the containing directory, so symlinked parents (/home -> /var/home) still match
	local dir="$path"
	local name=""
	if [ ! -d "$path" ] || [ -L "$path" ]; then
		dir="$(dirname "$path")"
		name="$(basename "$path")"
	fi

	local dir_top
	local prefix
	dir_top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || dir_top=""
	[ "$dir_top" = "$worktree" ] || die "add: $path is not inside $worktree"
	prefix="$(git -C "$dir" rev-parse --show-prefix)"

	local rel="$prefix$name"
	rel="${rel%/}"
	case "$rel" in
		"")
			die "add: refusing to add the worktree root"
			;;
		.git | .git/* | .worktreesync | .worktreesync/*)
			die "add: refusing to add $rel"
			;;
	esac

	if [ -n "$(git -C "$worktree" --literal-pathspecs ls-files -- "$rel")" ]; then
		die "add: $rel is tracked by the project repo"
	fi

	echo "$rel"
}


# entry_add file rel
# Append an anchored entry for rel to an ignore-style file; fails if one is already present
entry_add() {
	if [[ $# -ne 2 ]]; then
		die "entry_add: expected <file> <rel>"
	fi

	local file="$1"
	local rel="$2"

	if [ -f "$file" ] && grep -qxF -e "$rel" -e "/$rel" -e "$rel/" -e "/$rel/" "$file"; then
		return 1
	fi

	# Don't glue the entry onto a last line with no trailing newline
	if [ -s "$file" ] && [ -n "$(tail -c1 "$file")" ]; then
		echo >>"$file"
	fi
	echo "/$rel" >>"$file"
}


# sync_add update [path...]
sync_add() {
	if [[ $# -lt 1 ]]; then
		die "sync_add: expected <update> [path...]"
	fi

	local update="$1"
	shift

	sync_context

	# Validate everything before touching any files
	local rels=()
	local path
	for path in "$@"; do
		rels+=("$(worktree_relpath "$path")")
	done

	local include="$worktree/.worktreeinclude"
	local exclude
	exclude="$(git -C "$worktree" rev-parse --path-format=absolute --git-path info/exclude)"
	mkdir -p "$(dirname "$exclude")"

	local include_changed=false
	local rel
	for rel in "${rels[@]}"; do
		if entry_add "$include" "$rel"; then
			echo "Add $rel to .worktreeinclude"
			include_changed=true
		fi
		if entry_add "$exclude" "$rel"; then
			echo "Add $rel to $exclude"
		fi

		# Local files are usually gitignored by the project, so force them in
		echo "Stage $rel"
		sync_git add --force -- "$rel"
	done

	if [ "$include_changed" = true ]; then
		echo "Stage .worktreeinclude"
		sync_git add --force -- .worktreeinclude
	fi

	if [ "$update" = true ]; then
		echo "Stage changes to tracked files"
		sync_git add --update

		# add --update skips new files, so re-add directories listed in .worktreeinclude
		if [ -f "$include" ]; then
			local entry
			while IFS= read -r entry || [ -n "$entry" ]; do
				case "$entry" in
					"" | "#"* | "!"*)
						continue
						;;
				esac
				entry="${entry#/}"
				entry="${entry%/}"
				if [ -d "$worktree/$entry" ] && [ ! -L "$worktree/$entry" ]; then
					echo "Stage new files in $entry"
					sync_git add --force -- "$entry"
				fi
			done <"$include"
		fi
	fi
}



# sync_commit [message]
# With no message, git opens the editor as usual
sync_commit() {
	if [[ $# -gt 1 ]]; then
		die "sync_commit: expected [message]"
	fi

	sync_context

	if [[ $# -eq 1 ]]; then
		sync_git commit -m "$1"
	else
		sync_git commit
	fi
}



# The hook and clone both set the branch to track the hub's origin/master
sync_push() {
	sync_context

	sync_git push
}



# sync_pull rebase
# Without rebase, divergence is handled by the pull.* settings in git config
sync_pull() {
	if [[ $# -ne 1 ]]; then
		die "sync_pull: expected <rebase>"
	fi

	local rebase="$1"

	sync_context

	if [ "$rebase" = true ]; then
		sync_git pull --rebase
	else
		sync_git pull
	fi
}



# The hub is local, so fetch first to make the ahead/behind report current
sync_status() {
	sync_context

	sync_git fetch --quiet origin \
		|| echo "$PROGRAM: warning: could not fetch from the hub; ahead/behind may be stale" >&2
	sync_git status
}


main "$@"
