#!/usr/bin/env bash

set -euo pipefail
# set -x

PROGRAM="$(basename "$0")"

# Resolve symlinks so bundled files are found when installed via a link on PATH
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
HOOK_SRC="$SCRIPT_DIR/hooks/post-checkout"

# Branch used by the worktreesync hub; the post-checkout hook tracks origin/master
SYNC_BRANCH="master"


usage() {
	cat <<EOF
Usage: $PROGRAM [OPTIONS] COMMAND [ARGS...]

Manage a worktree based project layout and sync local files across worktrees.

Commands:
  init ORIGIN DIR   Clone ORIGIN as a bare repo into the new project directory DIR
                    and set up the worktreesync hub for local files

Options:
  -h, --help        Show this help message and exit
EOF
}


die() {
	echo "$PROGRAM: $*" >&2
	exit 1
}


main() {
	# Require util-linux (enhanced) getopt, which exits 4 when probed with -T
	getopt -T >/dev/null && die "GNU enhanced getopt is required"

	local parsed
	parsed="$(getopt --name "$PROGRAM" --options 'h' --longoptions 'help' -- "$@")" \
		|| { usage >&2; exit 2; }
	eval set -- "$parsed"

	while true; do
		case "$1" in
			-h | --help)
				usage
				exit 0
				;;
			--)
				shift
				break
				;;
			*)
				die "unhandled option: $1"
				;;
		esac
		shift
	done

	if [[ $# -eq 0 ]]; then
		die "expected a command; try --help"
	fi

	local command="$1"
	shift
	case "$command" in
		init)
			if [[ $# -ne 2 ]]; then
				die "init: expected ORIGIN DIR"
			fi
			project_init "$1" "$2"
			;;
		*)
			die "unknown command: $command"
			;;
	esac
}


# project_init origin dir
project_init() {
	if [[ $# -ne 2 ]]; then
		die "project_init: expected <origin> <dir>"
	fi

	local origin="$1"
	local project_dir="$2"

	[ -f "$HOOK_SRC" ] || die "post-checkout hook not found at $HOOK_SRC"

	# Allow an existing empty directory, but never clobber anything
	if [ -e "$project_dir" ] && [ -n "$(ls -A "$project_dir" 2>/dev/null)" ]; then
		die "$project_dir already exists and is not empty"
	fi

	mkdir -p "$project_dir"
	project_dir="$(realpath "$project_dir")"

	echo "Clone bare repo from $origin"
	git clone --bare "$origin" "$project_dir"/.remote.bare

	# Create a pointer to the bare git to allow commands from the project dir
	echo "gitdir: ./.remote.bare" >"$project_dir"/.git

	# A bare clone maps remote heads straight onto local heads; track them as remotes instead
	echo "Fix bare repo fetch refs"
	git -C "$project_dir" config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
	git -C "$project_dir" fetch origin

	echo "Create worktreesync hub"
	git init --quiet --bare --initial-branch="$SYNC_BRANCH" "$project_dir"/.worktreesync.bare

	# Check out the hub in the project root and seed it with the include list
	git clone --quiet "$project_dir"/.worktreesync.bare "$project_dir"/.worktreesync 2>/dev/null
	echo ".worktreeinclude" >"$project_dir"/.worktreesync/.worktreeinclude
	git -C "$project_dir"/.worktreesync checkout --quiet -B "$SYNC_BRANCH"
	git -C "$project_dir"/.worktreesync add .worktreeinclude
	git -C "$project_dir"/.worktreesync commit --quiet -m "Initial commit"
	git -C "$project_dir"/.worktreesync push --quiet -u origin "$SYNC_BRANCH"

	# Keep the worktreesync files out of the project repo in every worktree
	echo "Add worktreesync files to local excludes"
	mkdir -p "$project_dir"/.remote.bare/info
	cat >>"$project_dir"/.remote.bare/info/exclude <<'EOF'
.worktreesync
.worktreeinclude
EOF

	# Hooks for `git worktree add` run from the common (project) git dir
	echo "Install post-checkout hook"
	install -m 755 "$HOOK_SRC" "$project_dir"/.remote.bare/hooks/post-checkout

	echo "Initialized $project_dir"
}


main "$@"
