#compdef git-wts
#description manage a worktree project layout and sync local files

# Completes both `git-wts ...` and `git wts ...`: _git dispatches to _git-wts with
# the words shifted so words[1] is the command name either way.

(( $+functions[__git_wts_origins] )) ||
__git_wts_origins() {
	_alternative \
		'urls:repository URL:_urls' \
		'directories:local repository:_directories'
}

(( $+functions[__git_wts_commands] )) ||
__git_wts_commands() {
	local -a commands=(
		'clone:clone a repository into a new worktree project directory'
		'add:stage local files in the worktree'\''s .worktreesync'
		'commit:commit staged changes in the worktree'\''s .worktreesync'
		'push:push .worktreesync commits to the hub'
		'pull:pull hub commits into the worktree'\''s .worktreesync'
		'status:show the worktree'\''s .worktreesync status against the hub'
	)
	_describe -t commands 'git-wts command' commands
}

_git-wts() {
	local curcontext=$curcontext state line ret=1
	typeset -A opt_args

	_arguments -C \
		'(- *)'{-h,--help}'[show help message and exit]' \
		'1: :->command' \
		'*:: :->argument' && return

	case $state in
		(command)
			__git_wts_commands && ret=0
			;;
		(argument)
			curcontext=${curcontext%:*}-$words[1]:
			case $words[1] in
				(clone)
					_arguments \
						'1:origin repository:__git_wts_origins' \
						'2:project directory:_directories' && ret=0
					;;
				(add)
					_arguments \
						'(-u --update)'{-u,--update}'[also stage changes to files already synced]' \
						'*:local file:_files' && ret=0
					;;
				(commit)
					_arguments \
						'(-m --message)'{-m+,--message=}'[use the given message instead of opening an editor]:message' && ret=0
					;;
				(pull)
					_arguments \
						'(-r --rebase)'{-r,--rebase}'[rebase local commits onto the hub]' && ret=0
					;;
				(push|status)
					_message 'no arguments' && ret=0
					;;
				(*)
					_message "unknown git-wts command: $words[1]"
					;;
			esac
			;;
	esac

	return ret
}

_git-wts "$@"
